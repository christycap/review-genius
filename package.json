{
    "name": "review-genius",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node --env-file=.env --import tsx src/index.ts",
        "_format": "prettier '**/*.{ts,tsx,json,md}'",
        "format": "npm run _format -- --write",
        "format:check": "npm run _format -- --list-different"
    },
    "lint-staged": {
        "*.{ts,tsx,json,md}": [
            "prettier --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged -v"
        }
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "husky": "^4.3.8",
        "lint-staged": "^11.1.1",
        "prettier": "^2.8.8",
        "tsx": "^4.20.0",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "zod": "^4.4.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "husky@4.3.8": true
    }
}
